# Copy this file to .env and fill in the required values:
#
#   cp .env.example .env
#
# Compose loads .env automatically. Every setting below the "Optional" section
# has a sane default in src/transcription_bot/settings.py and only needs to be
# set when the default does not fit.

# --- Required ---------------------------------------------------------------
# Telegram API credentials from https://my.telegram.org
API_ID=
API_HASH=
# Your own Telegram username, used for notifications
MY_USERNAME=
# https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=
# MinIO/S3 credentials
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
# OpenAI-compatible API key
OPENAI_API_KEY=

# --- Optional overrides -----------------------------------------------------
# SESSION_FILE=credentials/telegram.session
# MINIO_HOST=localhost:9000
# MINIO_BUCKET=transcription-bot
# MODEL_VERSION=latest
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL_NAME=gpt-4o-mini
# TZ=Asia/Singapore
# LOG_LEVEL=INFO
